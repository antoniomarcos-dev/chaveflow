# Runtime: configure these in Vercel (Production and Preview use separate databases).
SUPABASE_URL=
# Backend only: use a secret key (sb_secret_...). Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
CHAVEFLOW_SESSION_SECRET=
CHAVEFLOW_APP_URL=http://localhost:3000

# Required for password recovery by e-mail. Account activation links work without it.
# Use a verified sender/domain in Resend.
RESEND_API_KEY=
CHAVEFLOW_EMAIL_FROM=

# One-time setup only: set locally, run npm run db:setup, then remove the password.
# Do not add these bootstrap values to Vercel.
CHAVEFLOW_ORGANIZATION_NAME=
CHAVEFLOW_ORGANIZATION_CNPJ=
CHAVEFLOW_BRANCH_NAME=
CHAVEFLOW_BRANCH_CITY=
CHAVEFLOW_BRANCH_STATE=
CHAVEFLOW_BRANCH_ADDRESS=
CHAVEFLOW_BRANCH_PHONE=
CHAVEFLOW_ADMIN_NAME=
CHAVEFLOW_ADMIN_EMAIL=
CHAVEFLOW_ADMIN_PASSWORD=
