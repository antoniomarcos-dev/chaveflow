# ==============================================================================
# CHAVEFLOW — CONFIGURAÇÃO DE AMBIENTE (.env.example)
# Copie para .env.local e preencha conforme o ambiente.
# NUNCA adicione chaves reais no controle de versão.
# ==============================================================================

# Modo de operação:
# "demo" = Usa banco persistente local (.data/chaveflow-db.json) com dados demonstrativos da Pinauto BYD Ceres/GO.
# "production" = Exige PostgreSQL / Supabase configurados e desativa seletores de persona demonstrativa.
CHAVEFLOW_ENV_MODE=demo

# Segredo para assinatura de sessões e links temporários de documentos privados
CHAVEFLOW_SESSION_SECRET=substitua_por_um_segredo_longo_e_aleatorio_em_producao_min_32_chars

# Configuração Supabase / PostgreSQL (Opcional no modo demonstrativo; obrigatório em produção)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Diretório local para armazenamento persistente privado no modo demonstrativo
CHAVEFLOW_LOCAL_DATA_DIR=.data

# Integrações Opcionais (Desabilitadas por padrão no MVP — operam via adaptadores)
CHAVEFLOW_AI_PROVIDER=deterministic
OPENAI_API_KEY=
CHAVEFLOW_EMAIL_PROVIDER=simulated
SMTP_HOST=
CHAVEFLOW_WHATSAPP_PROVIDER=simulated
WHATSAPP_API_TOKEN=
